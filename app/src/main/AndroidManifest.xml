<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- غير للأجهزة القديمة (API 28 وتحت) - كتخدم كونفيغ .ml مباشرة فـ
         Downloads بلا MediaStore. Android 10+ ماخاصهاش هاد الصلاحية. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MR VPN TUNNEL"
        android:theme="@style/Theme.SshProxyPayload"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="MR VPN TUNNEL"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ===== استقبال ملف .ml عبر "Open with" (مدير ملفات، أو
                 رابط file://) - ACTION_VIEW فقط، بلا BROWSABLE (هاديك
                 مخصصة للروابط http/https ديال المتصفح، ماشي للملفات،
                 وكانت هي اللي كتخلي التطبيق يبان فأماكن ماعندوش علاقة
                 بيهم + كتزيد فمشكل الأيقونة العالقة). كنقبلو غير
                 mimeType اللي عادة كيتعطى للملفات بامتداد غير معروف
                 (application/octet-stream) - ماشي "*/*" لكل الملفات. ===== -->
            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- نفس الفكرة، لكن ب pathPattern على الامتداد .ml - كتخدم
                 فالغالب غير مع file:// (روابط content:// كتخبي المسار
                 الحقيقي عادة، فماكيمكنش نعتمدو عليها بوحدها). -->
            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:pathPattern=".*\\.ml" />
            </intent-filter>

            <!-- ===== استقبال ملف .ml عبر "Share" (تلغرام/واتساب) -
                 ACTION_SEND وحدو، بلا BROWSABLE، وبنفس mimeType المقيد
                 باش التطبيق ما يبانش كخيار مشاركة لكل صورة/فيديو/ملف
                 كيشاركو المستخدمين. ===== -->
            <intent-filter android:priority="500">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".SshVpnService"
            android:process=":vpnproc"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
