<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/transparent"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="176dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_logo_glow" />
        <ImageView
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:src="@drawable/drawer_logo_reference"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="MR VPN TUNNEL"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Secure SSH • VPN"
        android:textColor="#C7D1DC"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_nav_status_pill">
        <View
            android:id="@+id/imgNavStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_nav_status_dot" />
        <TextView
            android:id="@+id/txtNavStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Disconnected"
            android:textColor="#AAB6C3"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
