<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_drawer_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="26dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_nav_logo_glow" />

        <ImageView
            android:id="@+id/imgNavLogo"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:src="@drawable/drawer_logo_transparent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="MR VPN TUNNEL"
        android:textColor="@color/drawer_text"
        android:textSize="19sp"
        android:textStyle="bold"
        android:letterSpacing="0.045"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginEnd="8dp"
            android:background="@color/drawer_neon_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure SSH • VPN"
            android:textColor="@color/drawer_subtitle"
            android:textSize="12sp"
            android:letterSpacing="0.025" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:background="@color/drawer_neon_purple" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_nav_status_pill">

        <View
            android:id="@+id/imgNavStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_nav_status_dot" />

        <TextView
            android:id="@+id/txtNavStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Disconnected"
            android:textColor="@color/drawer_subtitle"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.025" />

    </LinearLayout>

</LinearLayout>
