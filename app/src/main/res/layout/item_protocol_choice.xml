<?xml version="1.0" encoding="utf-8"?>
<!--
    صف واحد فقائمة "Choose Protocol": Card بحواف مدورة فيها أيقونة
    البروتوكول (فدائرة صغيرة)، الاسم + Description تحته، ودائرة اختيار
    (Radio) على اليمين. الخلفية (شكل عادي/مميز بالأخضر) والأيقونة/الـ
    Radio كيتبدلو ديناميكيا من الكود (MainActivity.showProtocolPicker)
    حسب PROTOCOL_OPTIONS - هاد الـlayout ماشي مرتبط بأي بروتوكول معين،
    فبروتوكول جديد يزاد فـPROTOCOL_OPTIONS غادي يستعمل نفس الصف تلقائيا
    بلا أي تعديل هنا.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="14dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/shape_card_alt">

    <!-- أيقونة البروتوكول داخل دائرة صغيرة -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/shape_icon_badge">

        <ImageView
            android:id="@+id/imgProtocolIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <!-- اسم البروتوكول + Description صغير تحته -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtProtocolName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/txtProtocolDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12.5sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- دائرة الاختيار (Radio) -->
    <ImageView
        android:id="@+id/imgProtocolRadio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        tools:ignore="ContentDescription" />

</LinearLayout>
