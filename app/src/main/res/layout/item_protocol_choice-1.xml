<?xml version="1.0" encoding="utf-8"?>
<!--
    صف واحد فقائمة "Choose Protocol": اسم البروتوكول + خط فاصل أخضر رفيع
    تحته. بلا أي دائرة اختيار، بلا Radio Button، بلا علامة ✓، وبلا خلفية
    كبيرة حول العنصر - غير النص كيتبدل لونو (أخضر Accent) ملي يكون هو
    البروتوكول المختار حاليا (كيتقرا من manualFieldsPrefs فـ MainActivity).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtProtocolName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textSize="16sp"
        android:textColor="@color/text_primary" />

    <!-- خط فاصل أخضر رفيع بين كل بروتوكول والآخر - غير مبين بعد آخر عنصر
         فالقائمة (كيتحكم فيه الكود فـ MainActivity.kt). -->
    <View
        android:id="@+id/dividerProtocol"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/accent_green" />

</LinearLayout>
