<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_dialog_bg"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import Code"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Paste your MRVPN, VLESS, VMess, Trojan, Shadowsocks or JSON code below."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edtImportCode"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_dialog_input"
        android:gravity="top|start"
        android:hint="Paste MRVPN / VLESS / VMess /\nTrojan / Shadowsocks / JSON"
        android:textColorHint="#661DB954"
        android:textColor="@color/accent_green"
        android:textColorHighlight="#331DB954"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:padding="14dp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/screen_surface_alt"
            android:text="CANCEL"
            android:textColor="@color/text_secondary"
            app:cornerRadius="14dp"
            app:strokeColor="@color/screen_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_green"
            android:text="IMPORT"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
