<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2B1242" android:endColor="#140B21" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#C04DFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#35124F" android:endColor="#160A25" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#A84DFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/drawer_card_bg" android:endColor="@color/drawer_card_bg_end" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#592A78" />
        </shape>
    </item>
</selector>
