<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#06111C"
                android:centerColor="#071725"
                android:endColor="#050B12" />
        </shape>
    </item>
    <item android:gravity="top|start" android:top="40dp" android:left="-120dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="250dp" android:centerColor="#173B64" android:endColor="#00173B64" />
            <size android:width="620dp" android:height="360dp" />
        </shape>
    </item>
    <item android:gravity="center|start" android:left="-220dp" android:top="220dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerColor="#0A2E50" android:endColor="#000A2E50" />
            <size android:width="700dp" android:height="420dp" />
        </shape>
    </item>
</layer-list>
