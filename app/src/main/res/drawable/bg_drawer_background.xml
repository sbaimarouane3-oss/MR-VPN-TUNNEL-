<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#050A14"
                android:centerColor="#0A1526"
                android:endColor="#03060C" />
        </shape>
    </item>

    <!-- Soft blue atmosphere near the header -->
    <item android:gravity="top|center_horizontal" android:top="-95dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerColor="#12409E"
                android:endColor="#0012409E" />
            <size android:width="620dp" android:height="420dp" />
        </shape>
    </item>

    <item android:gravity="top|start" android:left="-170dp" android:top="120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerColor="#2478E0"
                android:endColor="#002478E0" />
            <size android:width="540dp" android:height="330dp" />
        </shape>
    </item>

    <item android:gravity="bottom|end" android:right="-210dp" android:bottom="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="270dp"
                android:centerColor="#123A6E"
                android:endColor="#00123A6E" />
            <size android:width="600dp" android:height="400dp" />
        </shape>
    </item>
</layer-list>
