<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SshProxyPayload" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/app_bg</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- زوايا مدورة لعناصر القائمة الجانبية (NavigationView) -->
    <style name="ShapeAppearanceOverlay.NavItem" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- حقول الإدخال الحديثة (Outlined) بلون أخضر عند التركيز -->
    <style name="ModernTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_green</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/accent_green</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/surface_card_alt</item>
    </style>
</resources>
